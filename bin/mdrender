#!/usr/bin/env bash
# Cross-platform launcher for MD_RENDER.
#   mdrender                          open the app
#   mdrender FILE.md                  open the app on FILE.md
#   mdrender --port 8080 FILE... DIR  serve rendered markdown over HTTP
#   mdrender --mcp                    run the MCP server over stdio (for agents)
set -euo pipefail

APP_NAME="MD_RENDER"

# Absolute path of this script, so the Linux lookup never re-executes the wrapper.
self_path() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s\n' "$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
}

abs_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
  elif [ -e "$1" ]; then
    printf '%s\n' "$(cd -P "$(dirname "$1")" && pwd)/$(basename "$1")"
  else
    case "$1" in
      /*) printf '%s\n' "$1" ;;
      *)  printf '%s\n' "$PWD/$1" ;;
    esac
  fi
}

# Locate the installed Linux executable, skipping this wrapper itself.
find_linux_binary() {
  local self candidate resolved
  self="$(self_path)"

  # Deliberately excludes "mdrender": that is this wrapper's own installed name,
  # so matching it would launch the wrapper again instead of the app.
  for candidate in md-render "$APP_NAME"; do
    if resolved="$(command -v "$candidate" 2>/dev/null)"; then
      resolved="$(abs_path "$resolved")"
      if [ "$resolved" != "$self" ]; then
        printf '%s\n' "$resolved"
        return 0
      fi
    fi
  done

  for candidate in \
    "$HOME/.local/lib/md-render/$APP_NAME" \
    "$HOME/.local/bin/md-render" \
    /usr/bin/md-render \
    /usr/local/bin/md-render \
    "/usr/lib/md-render/$APP_NAME"; do
    if [ -x "$candidate" ] && [ "$(abs_path "$candidate")" != "$self" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  # Fall back to a local release build when running from a checkout.
  local repo_root
  repo_root="$(cd -P "$(dirname "$self")/.." && pwd)"
  for candidate in \
    "$repo_root/src-tauri/target/release/$APP_NAME" \
    "$repo_root/src-tauri/target/release/md-render"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

# Rewrite the argument list: flags and their values pass through untouched,
# bare paths are made absolute so the app resolves them from any directory.
# Sets ARGS (rewritten argv), FIRST_FILE (first path, for macOS) and SERVE.
parse_args() {
  ARGS=()
  FIRST_FILE=""
  SERVE=""

  local expect_value=""
  local arg
  for arg in "$@"; do
    if [ "$expect_value" = "digits" ]; then
      expect_value=""
      if [[ "$arg" =~ ^[0-9]+$ ]]; then
        ARGS+=("$arg")
        continue
      fi
      # Not a port: fall through and handle it as a normal argument.
    elif [ -n "$expect_value" ]; then
      ARGS+=("$arg")
      expect_value=""
      continue
    fi

    case "$arg" in
      --port|-p)
        # The port value is optional, so only treat a following run of digits
        # as the value; a path after --port is a document, not a port.
        SERVE="yes"
        ARGS+=("$arg")
        expect_value="digits"
        ;;
      --host)
        ARGS+=("$arg")
        expect_value="yes"
        ;;
      --port=*|-p=*)
        SERVE="yes"
        ARGS+=("$arg")
        ;;
      -*)
        ARGS+=("$arg")
        ;;
      *)
        ARGS+=("$(abs_path "$arg")")
        [ -n "$FIRST_FILE" ] || FIRST_FILE="$(abs_path "$arg")"
        ;;
    esac
  done
}

# The MCP server is a single bundled JavaScript file, installed by `make
# install` or built in a checkout by `npm run build:mcp`. It speaks the
# protocol on stdin/stdout, so this must exec it in the foreground.
exec_mcp() {
  local self repo_root entry
  self="$(self_path)"
  repo_root="$(cd -P "$(dirname "$self")/.." && pwd)"

  for entry in \
    "${MDRENDER_MCP_DIR:+$MDRENDER_MCP_DIR/index.js}" \
    "$HOME/.local/share/md-render/mcp/index.js" \
    "$repo_root/mcp/dist/index.js"; do
    if [ -n "$entry" ] && [ -f "$entry" ]; then
      if ! command -v node >/dev/null 2>&1; then
        echo "mdrender: --mcp needs node (>= 20) on PATH" >&2
        exit 1
      fi
      exec node "$entry" "$@"
    fi
  done

  echo "mdrender: the MCP server is not built. Run 'make install' (or 'npm run build:mcp') from the repo." >&2
  exit 1
}

# Short and self-contained so an LLM (or a human) can inspect what the tool
# does without launching anything.
usage() {
  cat <<'EOF'
mdrender — MD_RENDER markdown renderer

  mdrender FILE|DIR...            open in the desktop app; several files -> tabs
  mdrender --port [PORT] PATH...  serve over HTTP instead (headless-friendly)
  mdrender --mcp                  MCP server over stdio, driving the --port mode

Serving: the default port is 9999, falling forward to the next free port when
another program holds it. Each directory (or a file's parent directory)
becomes a workspace at http://127.0.0.1:9999/<dirname>/ with one tab per
markdown file. Re-running the command against a live server adds to it.
JSON API on the port: /api/health, /api/files, /api/workspaces.

MCP: register with `claude mcp add mdrender -- mdrender --mcp`. Tools cover
servers, workspaces, tabs, documents, comments and the open browser's view.
EOF
}

main() {
  # The MCP server owns stdin/stdout from here on; nothing else may print.
  if [ "${1:-}" = "--mcp" ]; then
    shift
    exec_mcp "$@"
  fi

  local arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        usage
        exit 0
        ;;
    esac
  done

  parse_args "$@"

  # Serving is a terminal task: run it in the foreground on both platforms so
  # the banner is visible and ctrl-c stops it.
  if [ -n "$SERVE" ]; then
    case "$(uname -s)" in
      Darwin)
        local app_bin="/Applications/$APP_NAME.app/Contents/MacOS/md-render"
        if [ ! -x "$app_bin" ]; then
          app_bin="$(cd -P "$(dirname "$(self_path)")/.." && pwd)/src-tauri/target/release/md-render"
        fi
        if [ ! -x "$app_bin" ]; then
          echo "mdrender: MD_RENDER is not installed. Run 'make install' from the repo." >&2
          exit 1
        fi
        exec "$app_bin" "${ARGS[@]}"
        ;;
      Linux)
        local bin
        if ! bin="$(find_linux_binary)"; then
          echo "mdrender: MD_RENDER is not installed. Run 'make install' from the repo." >&2
          exit 1
        fi
        exec "$bin" "${ARGS[@]}"
        ;;
      *)
        echo "mdrender: unsupported platform '$(uname -s)'" >&2
        exit 1
        ;;
    esac
  fi

  case "$(uname -s)" in
    Darwin)
      if [ -z "$FIRST_FILE" ]; then
        open -a "$APP_NAME"
      else
        # Every path goes through as argv so several files open as tabs, same
        # as on Linux. TAURI_LAUNCH_FILE stays for older installed builds that
        # only read the env var.
        TAURI_LAUNCH_FILE="$FIRST_FILE" open -a "$APP_NAME" --args "${ARGS[@]}"
      fi
      ;;
    Linux)
      local bin
      if ! bin="$(find_linux_binary)"; then
        echo "mdrender: MD_RENDER is not installed. Run 'make install' from the repo." >&2
        exit 1
      fi

      # Foreground when asked, otherwise detach so the shell returns like macOS 'open'.
      if [ -n "${MDRENDER_FOREGROUND:-}" ]; then
        if [ -z "$FIRST_FILE" ]; then
          exec "$bin"
        else
          TAURI_LAUNCH_FILE="$FIRST_FILE" exec "$bin" "${ARGS[@]}"
        fi
      fi

      if [ -z "$FIRST_FILE" ]; then
        nohup "$bin" >/dev/null 2>&1 &
      else
        TAURI_LAUNCH_FILE="$FIRST_FILE" nohup "$bin" "${ARGS[@]}" >/dev/null 2>&1 &
      fi
      disown 2>/dev/null || true
      ;;
    *)
      echo "mdrender: unsupported platform '$(uname -s)'" >&2
      exit 1
      ;;
  esac
}

main "$@"
