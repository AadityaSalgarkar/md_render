#!/bin/bash
# mdv - Markdown Viewer
# Usage: mdv <file.md>

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PORT=3333

if [[ -z "$1" ]]; then
  echo "Usage: mdv <file.md>"
  exit 1
fi

# Resolve to absolute path
FILE_PATH="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

if [[ ! -f "$FILE_PATH" ]]; then
  echo "File not found: $FILE_PATH"
  exit 1
fi

# Check if server is running
if ! lsof -i :$PORT > /dev/null 2>&1; then
  echo "Starting server..."
  node "$SCRIPT_DIR/server.cjs" &
  sleep 0.5
fi

# Open in Firefox
ENCODED_PATH=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$FILE_PATH'))")
URL="http://localhost:$PORT/?file=$ENCODED_PATH"
open -a Firefox "$URL"

echo "Opened: $FILE_PATH"
