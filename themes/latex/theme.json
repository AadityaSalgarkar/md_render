{
  "themes": [
    {
      "id": "latex",
      "name": "LaTeX",
      "mode": "light",
      "blurb": "An article in New Computer Modern: numbered sections, indents, booktabs.",
      "vars": {
        "--bg-primary": "#FFFFFF",
        "--bg-secondary": "#FBFAF7",
        "--bg-editor": "#FFFFFF",
        "--bg-preview": "#FFFFFF",
        "--text-primary": "#000000",
