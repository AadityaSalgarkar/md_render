      "mode": "dark",
      "blurb": "A forest after dark — moss and amber under a pine canopy.",
      "vars": {
        "--bg-primary": "#14201A",
        "--bg-secondary": "#1B2A22",
        "--bg-editor": "#0F1813",
        "--bg-preview": "#14201A",
        "--text-primary": "#DCE5D8",
        "--text-secondary": "#97A691",
        "--text-muted": "#647060",
        "--accent": "#8FB36B",
        "--accent-hover": "#A3C57F",
        "--accent-secondary": "#D89A5B",
