{
  "themes": [
    {
      "id": "warm-paper",
      "name": "Warm Paper",
      "mode": "light",
      "blurb": "Premium book typography on aged cream stock.",
      "vars": {
        "--bg-primary": "#FAF7F2",
        "--bg-secondary": "#F5F1EA",
        "--bg-editor": "#FFFDF8",
        "--bg-preview": "#FAF7F2",
        "--text-primary": "#1A1A1A",
        "--text-secondary": "#5C5C5C",
        "--text-muted": "#8A8A8A",
        "--accent": "#C9553D",
