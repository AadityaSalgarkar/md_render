        "--font-mono": "\"IBM Plex Mono\", \"Fira Code\", monospace",
        "--code-keyword": "#C4A7E7",
        "--code-string": "#F6C177",
        "--code-number": "#EBBCBA",
        "--code-comment": "#6E6A86",
        "--code-function": "#9CCFD8",
        "--code-builtin": "#EB6F92",
        "--chart-1": "#C4A7E7",
        "--chart-2": "#9CCFD8",
        "--chart-3": "#F6C177",
        "--chart-4": "#EBBCBA",
        "--chart-5": "#EB6F92",
        "--chart-6": "#5FA3BF",
        "--chart-7": "#A6DA95",
        "--chart-8": "#908CAA"
      }
    }
  ]
