{
  "themes": [
    {
      "id": "nocturne",
      "name": "Nocturne",
      "mode": "dark",
      "blurb": "Muted dusk — soft iris and foam adrift on plum shadow.",
      "vars": {
        "--bg-primary": "#191724",
        "--bg-secondary": "#1F1D2E",
        "--bg-editor": "#13111E",
        "--bg-preview": "#191724",
        "--text-primary": "#E0DEF4",
        "--text-secondary": "#908CAA",
        "--text-muted": "#6E6A86",
        "--accent": "#C4A7E7",
        "--accent-hover": "#D2BBEF",
        "--accent-secondary": "#9CCFD8",
        "--border": "#2A2837",
        "--border-strong": "#3D3A52",
        "--code-bg": "#1F1D2E",
        "--selection": "rgba(196, 167, 231, 0.22)",
        "--shadow-fold": "8px 0 24px -8px rgba(0, 0, 0, 0.55)",
        "--math-display-bg": "var(--code-bg)",
        "--math-display-padding": "1em 1.5em",
        "--font-head": "\"Playfair Display\", Georgia, serif",
